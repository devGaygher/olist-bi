                      "fontSize": "12pt",
                      "color": "#1f2937"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Nota por categoria: 1 review por pedido (o mais recente); cada pedido conta uma vez em cada categoria que comprou.",
