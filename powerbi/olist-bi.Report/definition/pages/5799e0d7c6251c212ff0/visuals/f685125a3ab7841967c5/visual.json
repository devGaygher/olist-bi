                      "fontSize": "12pt",
                      "color": "#1f2937"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Produtos sem categoria entram como sem_categoria: nos totais e, se for o caso, no top 10.",
