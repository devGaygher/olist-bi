                      "fontFamily": "Segoe UI, system-ui, -apple-system, sans-serif",
                      "fontSize": "12pt",
                      "color": "#1f2937"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Ranking de nota só com categorias de 100+ pedidos avaliados; abaixo disso a nota oscila por acaso.",
                    "textStyle": {
                      "fontFamily": "Segoe UI, system-ui, -apple-system, sans-serif",
                      "fontSize": "12pt",
                      "color": "#1f2937"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Qual categoria avalia bem ou mal é fato; o motivo (qualidade, prazo, expectativa) é hipótese.",
