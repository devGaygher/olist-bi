	column Regiao =
			
			SWITCH(
			    TRUE(),
			    'olist vw_dim_cliente'[estado] IN {"AC","AP","AM","PA","RO","RR","TO"}, "Norte",
			    'olist vw_dim_cliente'[estado] IN {"AL","BA","CE","MA","PB","PE","PI","RN","SE"}, "Nordeste",
			    'olist vw_dim_cliente'[estado] IN {"DF","GO","MT","MS"}, "Centro-Oeste",
			    'olist vw_dim_cliente'[estado] IN {"ES","MG","RJ","SP"}, "Sudeste",
			    'olist vw_dim_cliente'[estado] IN {"PR","RS","SC"}, "Sul"
