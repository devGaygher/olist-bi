table Calendario
	lineageTag: cabe8450-1a2a-4ceb-b569-a75f48b43d51
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: e6ddc9a9-8452-4121-91fe-4f05bece3ca2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Ano
		formatString: 0
		lineageTag: 087c046e-201a-443e-b0fd-9569588feb8a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column MesNum
		formatString: 0
		lineageTag: 6ff1970f-507f-4ffa-8f88-dde75bcf313c
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesNum]

		annotation SummarizationSetBy = Automatic

	column DiaSemanaNum
		formatString: 0
		lineageTag: 95c084ee-d17c-4e44-bbe9-f798d58fb281
		summarizeBy: none
		isNameInferred
		sourceColumn: [DiaSemanaNum]

		annotation SummarizationSetBy = Automatic

	column DiaSemana
		lineageTag: c9c4a8f1-44ff-4122-82fd-81a4f17f0a61
		summarizeBy: none
		isNameInferred
		sourceColumn: [DiaSemana]
		sortByColumn: DiaSemanaNum

		annotation SummarizationSetBy = Automatic

	column MesOrdem
		formatString: 0
		lineageTag: 84ded9b8-7eb6-465c-b599-3da140eb7a8f
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesOrdem]

		annotation SummarizationSetBy = Automatic

	column MesRotulo
		lineageTag: b960817f-f7c6-4340-91b2-d6bece1aa3c3
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesRotulo]
		sortByColumn: MesOrdem

		annotation SummarizationSetBy = Automatic

	column Mes
		lineageTag: e91eb1eb-18db-422a-b5e3-16593f12b3a4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: MesNum

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2018, 8, 31 ) ),
				    "Ano", YEAR ( [Date] ),
				    "Mes", FORMAT([Date], "mmm"),
				    "MesNum", MONTH ( [Date] ),
				    "MesOrdem", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "MesRotulo",
				        SWITCH (
				            MONTH ( [Date] ),
				            1, "jan", 2, "fev", 3, "mar", 4, "abr", 5, "mai", 6, "jun",
				            7, "jul", 8, "ago", 9, "set", 10, "out", 11, "nov", 12, "dez"
				        ) & "/" & RIGHT ( YEAR ( [Date] ), 2 ),
				    "DiaSemanaNum", WEEKDAY ( [Date], 2 ),
				    "DiaSemana",
				        SWITCH (
				            WEEKDAY ( [Date], 2 ),
				            1, "seg", 2, "ter", 3, "qua", 4, "qui", 5, "sex", 6, "sáb", 7, "dom"
				        )
				)

	annotation PBI_Id = 1d337fe46522414d98a22dfb1e245fc6

